NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
# Hosting: isi DATABASE_URL sesuai connection string PostgreSQL dari provider.
# Pengaturan TLS/SSL mengikuti connection string provider.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Jika DATABASE_URL diisi, DB_* di bawah tidak digunakan.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cashflow
